# Variables del BFF. Copiar a `.env` en la raíz y completar.
# El servidor lo lee con --env-file-if-exists, así que sin `.env` arranca igual
# con los defaults de desarrollo.

# ── producción ─────────────────────────────────────────────────────────
# En producción, descomentar. Sin esto el BFF corre en modo desarrollo: deja
# abrir el cotizador directo desde localhost y, si falta PASE_SECRETO, firma los
# pases con un secreto que está en el repo. Al arrancar avisa en el log.
# NODE_ENV=production
#
# En producción el BFF sirve también el front compilado (`npm run build`), así
# que el proxy le pasa todo, no sólo /api. Tiene que conservar el Host: con eso
# el mismo origen se reconoce solo y ORIGENES_PERMITIDOS puede quedar vacía.
#
#   location / {
#     proxy_pass http://127.0.0.1:5181;
#     proxy_set_header Host $host;
#     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
#   }
#
# Si el build no está en packages/web/dist, indicar dónde:
WEB_DIST=

# ── motor de cotización ────────────────────────────────────────────────
MOTOR_URL=https://infinito.foxia.ar
MOTOR_UUID=994b4085-999d-4301-9531-607ff61fca42

# Puerto del BFF. El front lo proxea desde Vite.
PORT=5181

# ── quién puede embeber la app ─────────────────────────────────────────
# Los sitios de agencia que la meten en un <iframe>, separados por coma.
# Sin esto no la embebe nadie. Con esta lista se decide todo lo del embebido:
#   - la cabecera `frame-ancestors`, que manda el BFF junto con el HTML (y Vite
#     en desarrollo);
#   - a quién se le sirve el HTML y se le da un pase para usar /api: sólo a un
#     iframe cargado desde uno de estos sitios.
#
# OJO con `Referrer-Policy: no-referrer`: si el sitio de una agencia la manda,
# el navegador no dice desde dónde se carga el iframe y el cotizador contesta
# «sólo disponible desde el sitio de tu agencia». En el log del BFF aparece como
# `[pase] sin referer`. Se confirma en DevTools → Network, en las cabeceras de
# respuesta de la página de la agencia. Cualquier otra política deja pasar el
# origen, que es todo lo que hace falta.
SITIOS_EMBEBIBLES=https://www.agencia-uno.com.ar,https://agencia-dos.com.ar

# Firma de los pases. Obligatoria en producción, con 32 caracteres o más: sin
# ella el BFF no arranca. Cambiarla invalida los pases en curso, y los
# vendedores tienen que recargar la página. Para generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PASE_SECRETO=

# Desde qué origen se acepta una llamada a /api. NO es la lista de arriba:
# dentro del iframe el fetch sale con el origen de la app, no con el del sitio
# que la embebe. Si el front y el BFF comparten dominio, dejala vacía.
ORIGENES_PERMITIDOS=

# ── reCAPTCHA v3 ──────────────────────────────────────────────────────
# Protege crear la cotización, armar la constancia y mandar la solicitud. Lo
# carga sólo el cotizador: las agencias no hacen nada. Las claves se registran
# para el dominio de la app, no para el de las agencias; para que ande en
# desarrollo, registrar también `localhost`.

# Pública, la usa el front. Se fija AL COMPILAR: si cambia, hay que volver a
# correr `npm run build`. Vite la lee de este mismo `.env` de la raíz.
VITE_RECAPTCHA_SITE_KEY=

# Secreta, sólo el BFF. No renombrarla con prefijo VITE_: eso la mandaría al
# navegador. Obligatoria en producción (sin ella el BFF no arranca); en
# desarrollo, si falta, se saltea la verificación con un aviso.
RECAPTCHA_SECRETO=

# Debajo de este puntaje (de 0 a 1) se rechaza. El log registra acción y puntaje
# de cada verificación (`[recaptcha] solicitud · score 0.9 · ok`) para ajustarlo
# con tráfico real.
RECAPTCHA_SCORE_MINIMO=0.5

# Hostname de la app, tal como lo informa Google, separados por coma. Un token
# emitido en otro dominio se rechaza. En desarrollo se acepta además localhost.
RECAPTCHA_HOSTNAMES=infinito.cebrokers.com.ar

# ── límites ────────────────────────────────────────────────────────────
# Envíos por hora y por IP a /api/solicitud y /api/certificado.
LIMITE_POR_HORA=20

# Tope del cuerpo de /api/solicitud, el único que lleva fotos adjuntas. Topa
# también el total de los adjuntos, sumen lo que sumen los dos de abajo.
LIMITE_SOLICITUD_MB=20

# Cuántos adjuntos acepta una solicitud y cuánto puede pesar cada uno. Son las
# nueve tomas con margen; la pantalla de carga no deja subir más de 4 MB. Sólo
# se aceptan JPEG, PNG, WEBP y PDF, reconocidos por su contenido.
LIMITE_ADJUNTOS=12
LIMITE_ADJUNTO_MB=5

# Ponerlo en 1 sólo si hay un reverse proxy adelante que sanea
# X-Forwarded-For. Sin proxy, dejarlo vacío: la cabecera la escribe cualquiera
# y sería una forma de saltearse el límite.
CONFIAR_EN_PROXY=

# ── correo ─────────────────────────────────────────────────────────────
# Con Mailgun: Sending → Domain settings → SMTP credentials (no es la API key).
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@midominio.mailgun.org
SMTP_PASS=

# Dónde caen las solicitudes de emisión y con qué remitente salen.
MAIL_TO=emisiones@cebrokers.com.ar
MAIL_FROM=cotizador@midominio.mailgun.org
